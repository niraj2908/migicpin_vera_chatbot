# Which composer provider to use. Leave unset to auto-detect from whichever key below is
# present (Anthropic preferred if both are set); "template" always forces the deterministic,
# no-network composer regardless of what keys are set.
# COMPOSER_PROVIDER=template|anthropic|gemini
COMPOSER_PROVIDER=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_TIMEOUT_SECONDS=

GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_TIMEOUT_SECONDS=

# /v1/metadata fields (default to "REPLACE_BEFORE_SUBMISSION" placeholders if unset) -- must be
# set in the deployment environment before submitting the public URL.
VERA_TEAM_NAME=
VERA_TEAM_MEMBERS=
VERA_MODEL_NAME=
VERA_CONTACT_EMAIL=
VERA_SUBMITTED_AT=

# Read by the deployment platform, not by the app directly beyond `make serve`/Dockerfile's
# ${PORT:-8000} fallback -- most PaaS platforms inject this themselves; only needed locally if
# you want to run on something other than 8000.
PORT=
